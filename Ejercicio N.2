def calculo():
    
    try:
              
        # Cilindro
        rad_cilindro = float(Radio_cilindro.get())
        alt_cilindro = float(Altura_cilindro.get())

        # Esfera
        rad_esfera = float(Radio_esfera.get())

        # Piramide
        lad_piramide = float(Lado_piramide.get())
        alt_piramide = float(Altura_piramide.get())
        anc_piramide = float(Ancho_piramide.get())

        # Cubo
        lad_cubo = float(Lado_cubo.get())

        # Prisma
        lad_prisma = float(Lado_prisma.get())
        alt_prisma = float(Altura_prisma.get())
        lados_base_prisma = float(Lados_base_prisma.get())
        
        if lados_base_prisma < 3:
            messagebox.showerror("ADVERTENCIA", "Se debe ingresar 3 o mas lados")
            return
    
        # Objetos
        Mi_cilindro = Cilindro(rad_cilindro, alt_cilindro)
        
        Mi_esfera = Esfera(rad_esfera)
        
        Mi_piramide = Piramide(lad_piramide, alt_piramide, anc_piramide)
        
        Mi_cubo = Cubo(lad_cubo)
        
        Mi_prisma = Prisma(lados_base_prisma, lad_prisma, alt_prisma )
        
        # Cambio variable 
        
        # --- Cilindro ---
        
        volumen_Cilindro.set(f"Volumen ---> {Mi_cilindro.Volumen(): .2f}")
        superficie_Cilindro.set(f"Superficie ---> {Mi_cilindro.Superficie(): .2f}")
        
        # --- Esfera ---
        
        volumen_Esfera.set(f"Volumen ---> {Mi_esfera.Volumen(): .2f}")
        superficie_Esfera.set(f"Superficie ---> {Mi_esfera.Superficie(): .2f}")
        
        # --- Piramide ---
        
        volumen_Piramide.set(f"Volumen ---> {Mi_piramide.Volumen(): .2f}")
        superficie_Piramide.set(f"Superficie ---> {Mi_piramide.Superficie(): .2f}")
        
        # --- Cubo ---
        
        volumen_Cubo.set(f"Volumen ---> {Mi_cubo.Volumen(): .2f}")
        superficie_Cubo.set(f"Superficie ---> {Mi_cubo.Superficie(): .2f}")
        
        # --- Prisma ---
        
        volumen_Prisma.set(f"Volumen ---> {Mi_prisma.Volumen(): .2f}")
        superficie_Prisma.set(f"Superficie ---> {Mi_prisma.Superficie(): .2f}")
    
    except ValueError:
        messagebox.showerror("FALLO DE CALCULO", "Solo se admiten numeros\n Asegurese de llenar todos los recuadros") 

def limpieza():
    
    for valor in (Radio_cilindro, Altura_cilindro, Radio_esfera, Lado_piramide, Altura_piramide, Ancho_piramide, Lado_cubo, Lado_prisma, Altura_prisma, Lados_base_prisma):
