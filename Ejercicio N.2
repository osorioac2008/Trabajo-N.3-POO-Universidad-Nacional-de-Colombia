#---------------------------------------------------------------Codigo

import math

class Figuras:
    
    def __init__(self):
        self.volumen = 0.0
        self.superficie = 0.0
    
    def Volumen(self):
        pass
    
    def Superficie(self):
        pass
    
class Cilindro(Figuras):
    
    def __init__(self, rad_cilindro, alt_cilindro):
        super().__init__()
        self.radio = rad_cilindro
        self.altura = alt_cilindro
    
    def Volumen(self):
        self.volumen = math.pi * (self.radio ** 2) * self.altura
        return self.volumen

    def Superficie(self):
        self.superficie = 2 * math.pi * self.radio * (self.altura + self.radio)
        return self.superficie

class Esfera(Figuras):
    
    def __init__(self, rad_esfera):
        super().__init__()
        self.radio = rad_esfera
    
    def Volumen(self):
        self.volumen = (4 * math.pi * (self.radio ** 3)) / 3
        return self.volumen
    
    def Superficie(self):
        self.superficie = 4 * math.pi * (self.radio ** 2)
        return self.superficie

class Piramide(Figuras):
    
    def __init__(self, alt_piramide, lad_piramide, anc_piramide):
        super().__init__()
        self.altura = alt_piramide
        self.lado = lad_piramide
        self.ancho = anc_piramide
        self.area_base = self.lado * self.ancho
            
    def Volumen(self):
        self.volumen = (self.area_base * self.altura) / 3
        return self.volumen
    
    def Superficie(self):
        if self.lado == self.ancho:
            self.superficie = self.area_base + 4 * ((self.lado * self.altura) / 2)
        else:
            self.superficie = self.area_base + 2 * ((self.lado * self.altura) / 2) + 2 * ((self.ancho * self.altura) / 2)
        return self.superficie

class Cubo(Figuras):
    
    def __init__(self, lad_cubo):
        super().__init__()
        self.lado = lad_cubo
    
    def Volumen(self):
        self.volumen = self.lado ** 3
        return self.volumen
    
    def Superficie(self):
        self.superficie = 6 * (self.lado ** 2)
        return self.superficie
    
class Prisma(Figuras):
    
    def __init__(self, lados_base_prisma, lad_prisma, alt_prisma):
        super().__init__()
        self.altura = alt_prisma
        self.lado = lad_prisma
        if lados_base_prisma < 3:
            raise ValueError("Se requiere un minimo de 3 lados")
        self.lados_base = lados_base_prisma
        self.area_base = (lados_base_prisma * (lad_prisma ** 2)) / (4 * math.tan(math.pi / lados_base_prisma))
        self.area_cara = lad_prisma * alt_prisma
    
    def Volumen(self):
        self.volumen = self.area_base * self.altura
        return self.volumen
    
    def Superficie(self):
        self.superficie = 2 * self.area_base + (self.lados_base * self.area_cara)
        return self.superficie

