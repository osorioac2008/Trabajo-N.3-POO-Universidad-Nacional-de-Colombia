import math

class notas:
    def __init__(self, nota_1, nota_2, nota_3, nota_4, nota_5): 
        self.tabla = [nota_1, nota_2, nota_3, nota_4, nota_5]    
        self.promedio = sum(self.tabla) / len(self.tabla)
        
    def Promedio(self):
        return self.promedio
        
    
    def Desviacion_est(self):
        valores = []
        for nota in self.tabla:
            valores.append(nota - self.promedio)
            
        cuadrados = []
        for nota in valores:
            cuadrados.append(nota**2)
        
        suma = 0
        total = 0
        for nota in cuadrados:
            suma += nota
            total += 1
        
        desviacion = math.sqrt(suma / (total - 1))
        return desviacion
            
    def nota_mayor(self):
        self.tabla.sort()
        return self.tabla[-1]
        
    def nota_menor(self):
            self.tabla.sort()
            return self.tabla[0]
        
