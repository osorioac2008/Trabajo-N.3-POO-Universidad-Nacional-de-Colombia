#--------------------------------------------------------------------- Codigo, Metodos de interfaz

def calcular():
    try: # Decidir si proseguir o soltar error
        nota_1 = str(ingreso_1.get()).strip()
        nota_2 = str(ingreso_2.get()).strip()
        nota_3 = str(ingreso_3.get()).strip()
        nota_4 = str(ingreso_4.get()).strip()
        nota_5 = str(ingreso_5.get()).strip()
        
        if nota_1 == "" or nota_2 == "" or nota_3 == "" or nota_4 == "" or nota_5 == "":
            messagebox.showwarning("ADVERTENCIA", "Se debe llenar todos los campos")
            return
        
        nota_1 = float(ingreso_1.get())
        nota_2 = float(ingreso_2.get())
        nota_3 = float(ingreso_3.get())
        nota_4 = float(ingreso_4.get())
        nota_5 = float(ingreso_5.get())
    
        estudiante = notas(nota_1, nota_2, nota_3, nota_4, nota_5)
    
        promedio.set(f"Promedio = {estudiante.Promedio(): .2f}")
        desviacion.set(f"Desviacion Estandar = {estudiante.Desviacion_est(): .2f}")
        mayor.set(f"Nota mayor = {estudiante.nota_mayor()}")
        menor.set(f"Nota menor = {estudiante.nota_menor()}")
        
    except ValueError: #Soltar error
        
        messagebox.showerror("FALLO DE CALCULO", "Se debe ingresar notas validas")

def borrar():
    for ingreso in (ingreso_1, ingreso_2, ingreso_3, ingreso_4, ingreso_5):
        ingreso.delete(0, tk.END)
    
    promedio.set("Promedio = ")
    desviacion.set("Desviación estándar = ")
    mayor.set("Nota mayor = ")
    menor.set("Nota menor = ")

#--------------------------------------------------------------------- #Atributos de interfaz

envio = tk.Button(Notas, text="Envio", width=20, command = calcular) #Creador de botones
